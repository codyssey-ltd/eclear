# Cloudflare Pages headers — parity with the previous nginx vhost plus CSP.
# nginx served: X-Frame-Options SAMEORIGIN, HSTS 31536000+includeSubDomains,
# nosniff, X-XSS-Protection (deprecated — dropped). CSP tuned for this app:
# all JS/CSS is inline, mermaid is pinned+SRI on jsDelivr, mermaid PNG
# output and clipboard images are data:/blob: URIs.
# Notes: HSTS is short (3600) during the migration window for reversibility —
# raise to 31536000 + includeSubDomains after cutover is proven stable.
# Cache-Control must-revalidate so single-file deploys take effect immediately.
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=3600
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cache-Control: public, max-age=0, must-revalidate
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self' https://cdn.jsdelivr.net; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'self'
