# Ignore everything in root
/*

# Keep html directory and README
!html/
!html/**
!README.md
!LICENSE

# Keep .gitignore itself
!.gitignore

# Keep only the Pages deploy workflow (local harness workflows stay ignored)
!.gitea/
!.gitea/workflows/
.gitea/workflows/*
!.gitea/workflows/deploy-pages.yml

# Keep closure manifests only (atom payloads + other task artifacts stay ignored)
!tasks/
!tasks/issues/
!tasks/issues/*/
tasks/issues/*/*
!tasks/issues/*/atoms-manifest.json